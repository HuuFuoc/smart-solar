node_modules

# Build output
dist
dist-ssr
*.tsbuildinfo

# Env — never commit secrets (keep .env.example)
# .env.development chỉ chứa địa chỉ API công khai (không có bí mật) nên commit được;
# tài khoản mẫu để trong .env.development.local (khớp *.local nên không commit).
.env
.env.*
!.env.example
!.env.development
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test / coverage
coverage

# Screenshot doi chieu thiet ke (tmp/<screen>.png)
tmp

