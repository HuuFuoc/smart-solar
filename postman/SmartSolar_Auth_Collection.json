    {
      "name": "2. Login",
      "item": [
        {
          "name": "Login - Success (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response returns token and stores {{jwt_token}}\", function () {",
                  "    const responseData = pm.response.json();",
                  "    pm.expect(responseData).to.be.an('object');",
                  "    ",
                  "    const token = responseData.jwt_token || ",
                  "                  responseData.token || ",
                  "                  responseData.accessToken || ",
                  "                  (responseData.data && (responseData.data.jwt_token || responseData.data.token || responseData.data.accessToken));",
                  "    ",
                  "    pm.expect(token, \"JWT token should exist in response\").to.be.a('string').and.not.empty;",
                  "    pm.environment.set(\"jwt_token\", token);",
                  "    console.log(\"Saved jwt_token into environment:\", token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"qa.test@example.com\",\n  \"password\": \"SecureP@ssw0rd2026\"\n}"
            },
            "url": {
