  "item": [
    {
      "name": "1. Register",
      "item": [
        {
          "name": "Register - Success (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"Response schema validation\", function () {",
                  "    const responseData = pm.response.json();",
                  "    pm.expect(responseData).to.be.an('object');",
                  "    pm.expect(responseData).to.satisfy(function(res) {",
                  "        return res.success === true || res.email === \"qa.test@example.com\" || (res.data && (res.data.email || res.data.id));",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"qatest_user\",\n  \"email\": \"qa.test@example.com\",\n  \"password\": \"SecureP@ssw0rd2026\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Register - Missing Required Fields (400 Bad Request)",
          "event": [
