# Base URL của API.
# Dev: để "/api" và dùng proxy của Vite (server.proxy → http://localhost:8080).
# Prod: điền URL tuyệt đối, ví dụ https://api.smartsolar.vn/api
VITE_API_BASE_URL=/api

# Đích proxy khi chạy dev; chỉ dùng trong vite.config.ts, không lộ ra client.
API_PROXY_TARGET=http://localhost:8080

# Tài khoản mẫu cho khối "Thử nhanh theo các vai trò" ở /login (chỉ hiện khi DEV).
# Copy sang .env.development.local (file này KHÔNG commit) rồi điền tài khoản thật.
VITE_DEMO_CUSTOMER_EMAIL=
VITE_DEMO_CUSTOMER_PASSWORD=
VITE_DEMO_TECHNICIAN_EMAIL=
VITE_DEMO_TECHNICIAN_PASSWORD=
VITE_DEMO_SALES_EMAIL=
VITE_DEMO_SALES_PASSWORD=
VITE_DEMO_MANAGER_EMAIL=
VITE_DEMO_MANAGER_PASSWORD=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
